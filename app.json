{
  "expo": {
    "name": "ozdeta",
    "slug": "ozdeta6",
    "version": "3.0.0",
    "orientation": "default",
    "icon": "./assets/derstakipicon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/derstakipicon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mhmt03.ozdeta",
      "buildNumber": "26"
    },
    "android": {
      "package": "com.mhmt03.ozdeta",
      "permissions": [
        "RECEIVE_BOOT_COMPLETED"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/derstakipicon.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 26
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "icon": "./assets/derstakipicon.png",
          "color": "#ffffff"
        }
      ],
      "expo-font",
      "expo-sharing",
      "expo-status-bar",
      "expo-contacts"
    ],
    "extra": {
      "eas": {
        "projectId": "6cc74ccf-e227-46df-b234-ce6a4097ef4d"
      }
    },
    "owner": "mhmt03s-team"
  }
}